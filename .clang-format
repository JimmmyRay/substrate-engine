BasedOnStyle: LLVM
Language: Cpp
# Indentation and line basics
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 120  # Increase to 160 if chains exceed this

# Bracing and short forms
BreakBeforeBraces: Attach
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLambdasOnASingleLine: All  # Compact short lambdas in chains

# Fluent chaining magic (prevents breaks before dots/args)
PenaltyBreakBeforeFirstCallParameter: 1000  # High: favors single-line chains
ContinuationIndentWidth: 4  # +4 from previous dot/parenthesis
AlignAfterOpenBracket: Align  # Vertically aligns params in calls/lambdas
BinPackArguments: false  # No tight packing—breaks cleanly if needed
BinPackParameters: false

# Pointers/spacing for clean refs in lambdas
PointerAlignment: Left
DerivePointerAlignment: false
SpaceBeforeParens: ControlStatements
SpacesInParentheses: false
SpacesInSquareBrackets: false

# Builder-specific (init lists, etc.)
BreakConstructorInitializers: BeforeComma
ConstructorInitializerIndentWidth: 4
Cpp11BracedListStyle: true

# Extras for readability
AlignTrailingComments: true
BreakBeforeBinaryOperators: None  # Keeps &&/|| left-aligned
SortIncludes: CaseSensitive