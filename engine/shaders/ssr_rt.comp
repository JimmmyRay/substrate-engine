// 460, not 450: glslang 11.8 only recognises GL_EXT_ray_query at GLSL 4.60.
#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
// Needed by raytrace.glsl, declared here because an #extension directive must
// precede every declaration in the translation unit and that header is included
// after frame.glsl has already declared one.
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require

// Ray-traced reflections (3.11). The same body as ssr.comp, with the screen-space
// march replaced by a ray query -- the file is the switch, because the acceleration
// structure and environment bindings it needs cannot be specialised away.
#define GBUFFER_MULTISAMPLE 1
#define ENABLE_RAY_QUERY 1

// The tracing passes already spend set 3 on the shadow layout, so the IBL layout lands
// at 4 and the bindless scene set at 5. Same layouts as the deferred path binds, just
// at different indices.
#define IBL_SET 4
#define RT_SCENE_SET 5

#include "frame.glsl"
#include "instance.glsl"
#include "octahedral.glsl"
#include "common.glsl"
#include "pbr.glsl"
#include "ibl.glsl"
#include "rayshadow.glsl"
#include "raytrace.glsl"
#include "ssr_body.glsl"
