#version 450
#extension GL_GOOGLE_include_directive : require

#include "ibl_common.glsl"

/**
 * Write the environment cubemap.
 *
 * Analytic rather than an HDR file, deliberately. A procedural sky needs no asset,
 * no licence and no download, and it is bit-identical between runs -- which is what
 * makes it usable as the reference environment for golden-image comparison (5.3).
 * The same cubemap and the same downstream chain would accept an equirect HDR
 * unchanged; only this shader would be replaced.
 *
 * It is a gradient plus a sun disc plus a ground bounce, not a Preetham model: the
 * point is a plausible HDR environment with real directional variation, and the
 * cheapest thing that produces one is the right thing here.
 */

layout(local_size_x = 8, local_size_y = 8) in;

// Binding 1, not 0: the IBL compute passes share one descriptor layout whose
// binding 0 is the source cubemap. This pass has no source, so it leaves that
// slot undeclared and therefore statically unused.
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2DArray outCube;

layout(push_constant) uniform Push {
    vec4 sunDirection; // xyz toward the sun, w intensity
    vec4 sunColor;     // rgb
    uint size;
} pc;

void main() {
    uvec3 id = gl_GlobalInvocationID;
    if (id.x >= pc.size || id.y >= pc.size) return;

    vec2 uv = (vec2(id.xy) + 0.5) / float(pc.size);
    vec3 dir = cubeDirection(id.z, uv);

    vec3 sun = normalize(pc.sunDirection.xyz);

    // Sky: a zenith-to-horizon gradient, brightening toward the sun so the
    // environment carries a direction rather than being a uniform dome.
    float up = clamp(dir.y * 0.5 + 0.5, 0.0, 1.0);
    vec3 zenith = vec3(0.10, 0.20, 0.42);
    vec3 horizon = vec3(0.52, 0.60, 0.72);
    vec3 sky = mix(horizon, zenith, pow(up, 0.65));

    float sunDot = clamp(dot(dir, sun), 0.0, 1.0);
    sky += pc.sunColor.rgb * pow(sunDot, 24.0) * 0.35;

    // The disc itself, well above 1.0. Without an HDR peak the prefiltered specular
    // has nothing bright enough to produce a recognisable highlight.
    float disc = smoothstep(0.9995, 0.9999, sunDot);
    sky += pc.sunColor.rgb * disc * pc.sunDirection.w * 40.0;

    // Ground: a dim diffuse bounce below the horizon rather than black, because a
    // black lower hemisphere makes every downward-facing surface unlit and reads as
    // a bug in the irradiance convolution.
    vec3 ground = vec3(0.16, 0.14, 0.12);
    float g = smoothstep(0.0, -0.05, dir.y);
    vec3 color = mix(sky, ground, g);

    imageStore(outCube, ivec3(id), vec4(color, 1.0));
}
